# Raw and potentially confidential research data
/data/

# Pipeline manifest snapshots (large, and duplicate what the pipeline repo pins)
/provenance/

# R and RStudio user state
/.Rproj.user/
/.Rhistory
/.RData
/.Ruserdata

# Local assistant settings
/.claude/settings.local.json

# renv dependency caches (retain activate.R, settings.json, and renv.lock)
/renv/library/
/renv/staging/
/renv/python/
/renv/local/
/renv/cellar/
/renv/sandbox/

# LaTeX intermediate and backup files
*.aux
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.spl
*.synctex.gz
*.tex.bak
*.toc
*.lof
*.lot

# Generated paper outputs (regenerated by plots.R / plots_and_tables.R /
# analysis_gap.R); manuscript source (manuscript.tex, references.bib, style
# files) stays tracked.
/latex_paper/manuscript.pdf
/latex_paper/manuscript.bbl
/latex_paper/figures/
/latex_paper/images/
/figures/
/tables/

# Operating-system files
.DS_Store
Thumbs.db
